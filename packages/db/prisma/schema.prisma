// Assay — hosted katman veri modeli.
//
// Bu şema `@assay/core`'daki kanonik kayıt tiplerinden türetilmiştir. Yerel
// dosya store ile hosted veritabanı aynı kavramsal modeli paylaşır; ayrışma
// `tools/schema-drift.test.ts` tarafından denetlenir.
//
// Ürünün değişmezleri burada **veritabanı seviyesinde** zorlanır. Uygulama
// katmanı hata yapabilir; CHECK kısıtı yapamaz:
//   - Bir oran, N ve güven aralığı olmadan satır olarak var olamaz (#4)
//   - `unknown` bir verdict gerekçesiz olamaz (#1)
//   - Okunamayan bir tetiklenme sinyali "tetiklenmedi" gibi saklanamaz (#1)
//   - Dört pin boş olamaz (#2)
// Kısıtların gerçekten tuttuğu `packages/db/src/constraints.test.ts` içinde
// gerçek bir Postgres (PGlite) üzerinde kanıtlanır.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Ölçüm
// ---------------------------------------------------------------------------

enum Verdict {
  PASS
  FAIL
  UNKNOWN
}

enum TraceEventKind {
  TOOL_CALL
  TOOL_RESULT
  ASSISTANT_MESSAGE
  SKILL_TRIGGER
  SESSION_END
}

enum SessionOutcome {
  COMPLETED
  ABORTED
  ERROR
}

/// Bir vaka seti. `version` + `hash` çifti pin 4'ü taşır.
model Suite {
  id     String @id @default(cuid())
  /// İnsan tarafından verilen ad. Ölçüme girmez.
  name   String
  /// `target.skill`
  skill  String
  /// Pin 1 — beyan edilen skill sürümü.
  source String

  /// Pin 4 — beyan edilen vaka seti sürümü.
  version Int
  /// Pin 4'ün denetçisi — suite kaynağının içerik hash'i.
  hash    String

  host             String
  model            String
  systemPromptHash String
  activeSkills     String[] @default([])

  /// Herkese açık mı. Varsayılan gizli: koşum kaydı istem metinlerini, araç
  /// argümanlarını ve dosya yollarını taşıyor.
  public Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  cases Case[]
  runs  Run[]

  /// Aynı içerik iki kez kaydedilmez; sürüm artmadan içerik değişirse ayrı satır.
  @@unique([skill, version, hash])
  @@index([ownerId, updatedAt])
  @@index([public])
}

/// Suite içindeki tek bir vaka.
model Case {
  id      String @id @default(cuid())
  suiteId String
  suite   Suite  @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  /// Hiyerarşik kimlik: `trigger.negative.near_neighbor.pdf`
  caseId String
  prompt String

  /// Tetiklenme iddiası. İddia yoksa null — vaka yalnızca artefakt ölçüyor
  /// olabilir. Vakanın *bir şey* ölçtüğü CHECK ile zorlanır.
  expectTriggered Boolean?
  /// Coexistence: tetiklenmemesi gereken diğer skill'ler.
  notTriggered    String[] @default([])
  /// Assertion listesi. Biçimi `@assay/core`'daki `Assertion` birleşimi.
  assertions      Json     @default("[]")

  /// Yakın komşu vakası mı — id konvansiyonundan türetilir, sorgulanabilir olsun diye saklanır.
  nearNeighbour Boolean @default(false)

  results CaseResult[]

  @@unique([suiteId, caseId])
  @@index([suiteId, expectTriggered])
}

/// Tek bir `assay run` koşumu.
model Run {
  /// CLI'ın ürettiği kimlik; hosted taraf kendi kimliğini dayatmaz.
  id      String @id
  suiteId String
  suite   Suite  @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  startedAt  DateTime @db.Timestamptz(3)
  finishedAt DateTime @db.Timestamptz(3)
  host       String
  /// Ölçülen skill'in adı. Kayıt kendi kendine yetsin diye pin'lerden ayrı.
  skill      String

  /// Dört pin ve iki denetçisi. Hiçbiri boş olamaz — karşılaştırmanın şartı.
  pinSkillSource      String
  pinSkillHash        String
  pinModel            String
  pinSystemPromptHash String
  pinSuiteVersion     Int
  pinSuiteHash        String

  /// Vaka başına tekrar sayısı. Asla 1 varsayılan değil (#3).
  runsPerCase Int

  verdict Verdict
  /// `verdict = UNKNOWN` ise zorunlu. CHECK ile.
  unknownReason String?

  uploadedAt DateTime @default(now()) @db.Timestamptz(3)
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  cases CaseResult[]

  @@index([suiteId, startedAt(sort: Desc)])
  @@index([ownerId, uploadedAt(sort: Desc)])
  @@index([verdict])
}

/// Bir vakanın N tekrarının toplamı.
model CaseResult {
  id     String @id @default(cuid())
  runId  String
  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  passed  Int
  failed  Int
  unknown Int

  /// Oran, N ve güven aralığı ayrılamaz (#4). CHECK ile bağlı.
  rateSuccesses Int
  rateN         Int
  rateValue     Float?
  ciLow         Float?
  ciHigh        Float?

  /// Vakanın tetiklenme iddiası — kayıt kendi kendine yetsin diye kopyalanır.
  expectTriggered Boolean?

  attempts Attempt[]

  @@unique([runId, caseId])
}

/// Tek bir tekrar.
model Attempt {
  id           String     @id @default(cuid())
  caseResultId String
  caseResult   CaseResult @relation(fields: [caseResultId], references: [id], onDelete: Cascade)

  index      Int
  startedAt  DateTime @db.Timestamptz(3)
  finishedAt DateTime @db.Timestamptz(3)
  verdict Verdict
  /// Her verdict gerekçe taşır; `UNKNOWN` için boş olamaz. CHECK ile.
  reason  String

  /// Tetiklenme gözlemi. Okunamadıysa `triggerAvailable = false` ve
  /// `triggerReason` dolu; o durumda `triggerTriggered` null kalır ki
  /// "tetiklenmedi" ile karışmasın. CHECK ile.
  triggerAvailable Boolean
  triggerTriggered Boolean?
  triggerComplete  Boolean?
  triggerVia       String?
  triggerReason    String?
  triggerSkills    String[] @default([])

  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  events     TraceEvent[]
  assertions AssertionResult[]
  envDiff    EnvDiff?

  @@unique([caseResultId, index])
  @@index([verdict])
}

/// Kanonik iz olayı.
model TraceEvent {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  seq  Int
  kind TraceEventKind
  at   DateTime? @db.Timestamptz(3)
  callId String?
  callRef String?
  tool   String?
  /// Araç argümanları. Sırlar kayıt yazılmadan önce maskelenir.
  args   Json?

  isError           Boolean?
  error             String?
  text              String?
  acknowledgesError Boolean?
  skill             String?
  outcome           SessionOutcome?

  @@unique([attemptId, seq])
  @@index([attemptId, kind])
}

/// Sandbox'ın gözlemlediği ortam değişimi.
model EnvDiff {
  id        String  @id @default(cuid())
  attemptId String  @unique
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  writes  String[] @default([])
  deletes String[] @default([])
  /// `NetworkRequest[]`
  network Json     @default("[]")
  /// Yan etkisi gözlenemeyen araçlar. Boş değilse yan etki iddiaları ölçülemez.
  unobserved String[] @default([])
}

/// Tek bir assertion sonucu.
model AssertionResult {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Assertion'ın kendisi — `@assay/core`'daki `Assertion`.
  assertion Json
  verdict   Verdict
  reason    String
  detail    Json?

  @@index([attemptId, verdict])
}

// ---------------------------------------------------------------------------
// Hesap
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  /// Credentials sağlayıcısı için Argon2id hash'i. OAuth kullanıcısında null.
  passwordHash  String?
  role          Role      @default(USER)
  suspendedAt   DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts  Account[]
  sessions  Session[]
  apiTokens ApiToken[]
  suites    Suite[]
  runs      Run[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime @db.Timestamptz(3)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

/// CLI'ın `assay push` komutu için uzun ömürlü token.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Token'ın kendisi saklanmaz; yalnızca hash'i ve son dört karakteri.
  tokenHash  String    @unique
  lastFour   String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
}

/// Yönetici işlemlerinin denetim kaydı.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  subject   String
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
