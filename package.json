{
  "name": "assay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --filter=!web build && pnpm --filter web build",
    "typecheck": "tsc -b --pretty && pnpm --filter web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
